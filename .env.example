# Supabase project credentials
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push VAPID public key (safe to expose client-side — it's the public
# half of the key pair). Generate a pair with `npx web-push generate-vapid-keys`.
# The PRIVATE key must never go here — set it as a Supabase Edge Function
# secret instead (`supabase secrets set VAPID_PRIVATE_KEY=...`). See
# supabase/functions/send-daily-reminders/index.ts for details.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
